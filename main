import asyncio
import logging
import os
import aiohttp
import json
from aiogram import Bot, Dispatcher, types
from aiogram.filters import Command, CommandObject
from aiogram.types import ReplyKeyboardRemove

TOKEN = os.getenv("BOT_TOKEN")

logging.basicConfig(level=logging.INFO)

bot = Bot(token=TOKEN)
dp = Dispatcher()

BINANCE_API = "https://api.binance.com/api/v3/ticker/24hr?symbol="
CBR_API = "https://www.cbr-xml-daily.ru/daily_json.js"


# ================= BINANCE =================

async def get_crypto(pair: str):
    async with aiohttp.ClientSession() as session:
        async with session.get(BINANCE_API + pair) as resp:
            if resp.status != 200:
                return None
            return await resp.json()


# ================= ЦБ РФ =================

async def get_usd_rub():
    async with aiohttp.ClientSession() as session:
        async with session.get(CBR_API) as resp:
            text = await resp.text()
            try:
                data = json.loads(text)
                return float(data["Valute"]["USD"]["Value"])
            except:
                return None


# ================= ФОРМАТ =================

def format_crypto(base, quote, data):
    price = float(data["lastPrice"])
    change = float(data["priceChangePercent"])
    volume = float(data["quoteVolume"])

    arrow = "🟢" if change >= 0 else "🔴"

    text = (
        f"📊 {base}/{quote}\n\n"
        f"💰 Цена: {price:,.4f}\n"
        f"{arrow} 24ч: {change:.2f}%\n"
        f"📈 Объём: {volume:,.0f}"
    )

    return text


# ================= КОМАНДЫ =================

@dp.message(Command("start"))
async def start(message: types.Message):
    await message.answer(
        "CryptoAll Bot\n\n"
        "Команды:\n"
        "/c BTC\n"
        "/c BTC RUB\n"
        "/usd",
        reply_markup=ReplyKeyboardRemove()
    )


@dp.message(Command("usd"))
async def usd(message: types.Message):
    rate = await get_usd_rub()
    if not rate:
        await message.reply("Ошибка получения курса ЦБ.")
        return

    await message.reply(f"💵 1 USD = {rate:.2f} ₽ (ЦБ РФ)")


@dp.message(Command("c"))
async def crypto(message: types.Message, command: CommandObject):
    if not command.args:
        await message.reply("Пример: /c BTC")
        return

    args = command.args.split()
    base = args[0].upper()
    quote = args[1].upper() if len(args) > 1 else "USDT"

    pair = f"{base}{quote}"
    data = await get_crypto(pair)

    if not data:
        await message.reply("Монета или пара не найдена.")
        return

    # Если USDT — добавим пересчёт в RUB
    if quote == "USDT":
        usd_rub = await get_usd_rub()
        if usd_rub:
            price_usdt = float(data["lastPrice"])
            price_rub = price_usdt * usd_rub
            rub_line = f"\n💱 RUB (через ЦБ): {price_rub:,.2f} ₽"
        else:
            rub_line = ""
    else:
        rub_line = ""

    text = format_crypto(base, quote, data) + rub_line
    await message.reply(text)


# ================= ЗАПУСК =================

async def main():
    await bot.delete_webhook(drop_pending_updates=True)
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
