import asyncio
import logging
import os
import aiohttp
import json
from aiogram import Bot, Dispatcher, types
from aiogram.filters import Command, CommandObject
from aiogram.types import ReplyKeyboardRemove

TOKEN = os.getenv("BOT_TOKEN")

logging.basicConfig(level=logging.INFO)

bot = Bot(token=TOKEN)
dp = Dispatcher()

BINANCE_API = "https://api.binance.com/api/v3/ticker/24hr?symbol="
CBR_API = "https://www.cbr-xml-daily.ru/daily_json.js"

SUPPORTED_QUOTES = ["USDT", "RUB", "EUR"]


# ================= BINANCE =================

async def get_crypto(pair: str):
    async with aiohttp.ClientSession() as session:
        async with session.get(BINANCE_API + pair) as resp:
            if resp.status != 200:
                return None
            return await resp.json()


# ================= ЦБ =================

async def get_cbr():
    async with aiohttp.ClientSession() as session:
        async with session.get(CBR_API) as resp:
            text = await resp.text()
            try:
                return json.loads(text)
            except:
                return None


async def get_usd_rub():
    data = await get_cbr()
    if not data:
        return None
    return float(data["Valute"]["USD"]["Value"])


# ================= ФОРМАТ =================

def format_crypto(base, quote, data):
    price = float(data["lastPrice"])
    change = float(data["priceChangePercent"])
    volume = float(data["quoteVolume"])

    arrow = "🟢" if change >= 0 else "🔴"

    return (
        f"📊 {base}/{quote}\n"
        f"💰 Цена: {price:,.4f}\n"
        f"{arrow} 24ч: {change:.2f}%\n"
        f"📈 Объём: {volume:,.0f}\n"
    )


# ================= КОМАНДЫ =================

@dp.message(Command("start"))
async def start(message: types.Message):
    await message.answer(
        "CryptoAll Terminal\n\n"
        "Введите /help для списка команд.",
        reply_markup=ReplyKeyboardRemove()
    )


@dp.message(Command("help"))
async def help_cmd(message: types.Message):
    await message.answer(
        "Доступные команды:\n\n"
        "/c BTC\n"
        "/c BTC RUB\n"
        "/c BTC EUR\n"
        "/c BTC ALL\n\n"
        "/usd\n"
        "/rates"
    )


@dp.message(Command("usd"))
async def usd(message: types.Message):
    rate = await get_usd_rub()
    if not rate:
        await message.reply("Ошибка получения курса ЦБ.")
        return
    await message.reply(f"💵 1 USD = {rate:.2f} ₽ (ЦБ РФ)")


@dp.message(Command("rates"))
async def rates(message: types.Message):
    data = await get_cbr()
    if not data:
        await message.reply("Ошибка получения курсов.")
        return

    text = "💱 Курсы ЦБ РФ:\n\n"
    for code in ["USD", "EUR", "CNY", "GBP"]:
        value = data["Valute"][code]["Value"]
        text += f"{code}: {value:.2f} ₽\n"

    await message.reply(text)


@dp.message(Command("c"))
async def crypto(message: types.Message, command: CommandObject):
    if not command.args:
        await message.reply("Пример: /c BTC")
        return

    args = command.args.split()
    base = args[0].upper()

    if len(args) > 1:
        quote = args[1].upper()
    else:
        quote = "USDT"

    # ALL режим
    if quote == "ALL":
        result_text = ""
        for q in SUPPORTED_QUOTES:
            pair = f"{base}{q}"
            data = await get_crypto(pair)
            if data:
                result_text += format_crypto(base, q, data) + "\n"

        if not result_text:
            await message.reply("Монета не найдена.")
            return

        await message.reply(result_text)
        return

    if quote not in SUPPORTED_QUOTES:
        await message.reply("Доступные валюты: USDT, RUB, EUR или ALL")
        return

    pair = f"{base}{quote}"
    data = await get_crypto(pair)

    if not data:
        await message.reply("Монета или пара не найдена.")
        return

    text = format_crypto(base, quote, data)

    # если USDT — добавим RUB через ЦБ
    if quote == "USDT":
        usd_rub = await get_usd_rub()
        if usd_rub:
            price_usdt = float(data["lastPrice"])
            rub_price = price_usdt * usd_rub
            text += f"💱 RUB (через ЦБ): {rub_price:,.2f} ₽"

    await message.reply(text)


# ================= ОБРАБОТКА НЕИЗВЕСТНЫХ =================

@dp.message()
async def unknown(message: types.Message):
    await message.reply("Неизвестная команда. Введите /help")


# ================= ЗАПУСК =================

async def main():
    await bot.delete_webhook(drop_pending_updates=True)
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
